{
  "name": "kaynar-motor-crm",
  "version": "1.0.0",
  "description": "Kaynar Motor - Servis Yönetim Sistemi (CRM)",
  "scripts": {
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm start\"",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "start": "cd backend && npm start",
    "build": "cd frontend && npm run build",
    "seed": "cd backend && npm run seed",
    "seed:gorseller": "cd backend && npm run seed:gorseller",
    "package:hostinger": "node scripts/package-hostinger.cjs",
    "test": "cd backend && npm test",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx}\" \"backend/**/*.{ts,js,cjs}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{js,jsx}\" \"backend/**/*.{ts,js,cjs}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.9.10"
  }
}
