{
  "name": "kaynar-motor-backend",
  "version": "1.0.0",
  "description": "Kaynar Motor CRM Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedLocal.js",
    "seed:gorseller": "node scripts/seedGorselIndir.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:parity": "node --test --test-concurrency=1 \"tests/parity/*.parity.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.0.2",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
