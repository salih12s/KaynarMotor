{
  "name": "kaynar-motor-backend",
  "version": "1.0.0",
  "description": "Kaynar Motor CRM Backend",
  "main": "server.js",
  "scripts": {
    "start": "tsx server.js",
    "dev": "tsx watch server.js",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "tsx scripts/seedLocal.js",
    "seed:gorseller": "tsx scripts/seedGorselIndir.js",
    "test": "node --import tsx --test \"tests/unit/*.test.js\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:parity": "node --import tsx --test --test-concurrency=1 \"tests/parity/*.parity.test.js\"",
    "test:api": "node --import tsx --test --test-concurrency=1 \"tests/api/*.test.js\"",
    "test:api:paket": "node scripts/testApiPaket.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
