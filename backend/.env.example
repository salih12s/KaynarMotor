# Bu dosyayi "backend/.env" olarak kopyalayip kendi degerlerinizle doldurun.
# .env dosyasi .gitignore icindedir, asla commit edilmez.

# Ortam: development | production
NODE_ENV=development

# Sunucu portu
PORT=5100

# --- Veritabani ---
# Ya tek parca DATABASE_URL verin (MariaDB)...
# DATABASE_URL=mysql://kullanici:sifre@127.0.0.1:3306/veritabani

# ...ya da asagidaki alanlari ayri ayri doldurun.
# Hostinger'da uygulama veritabanina 127.0.0.1:3306 ile baglanir (localhost IPv6'ya cozulebilir).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kaynar_dev
DB_USER=kaynar
DB_PASSWORD=buraya-kendi-sifrenizi-yazin

# --- Kimlik dogrulama ---
# Guclu ve rastgele bir deger uretin, orn:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=buraya-rastgele-uretilmis-uzun-bir-anahtar-yazin

# --- CORS ---
# Production'da mutlaka set edin; bos birakilirsa tum origin'lere izin verilir.
FRONTEND_URL=http://localhost:3100

# --- Ilk kurulum ---
# Veritabani bostken olusturulacak varsayilan admin sifresi.
# Set edilmezse admin kullanicisi otomatik olusturulmaz.
# ADMIN_INITIAL_PASSWORD=
