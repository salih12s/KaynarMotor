#!/usr/bin/env bash
# Push oncesi hizli guvenlik agi (GitHub Actions kullanilamiyorsa yerel CI): tip kontrolu + birim testler.
# Veritabani gerektirmez, saniyeler surer. Tam kontrol (API testleri) icin: bash backend/scripts/hepsiniDogrula.sh
# Etkinlestirmek: git config core.hooksPath .githooks      Gecici atlamak: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)/backend"
echo "[pre-push] tsc + birim testler..."
npm run -s typecheck
npm test --silent
echo "[pre-push] tamam"
