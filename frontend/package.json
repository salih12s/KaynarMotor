{
  "name": "kaynar-motor-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.13.2",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "react-scripts": "5.0.1",
    "react-to-print": "^3.2.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "react-scripts test",
    "test:hizli": "react-scripts test --watchAll=false --testPathIgnorePatterns Raporlar.test IsEmirleri.test Vitrin.test MotorStok.test IkinciElMotor.test Storefront.test ETicaret.test Aksesuarlar.test",
    "lint": "eslint src --ext .js,.jsx",
